# Project Pi settings. Credentials never fall back to ~/.pi/agent.
# Custom provider definitions: config/pi/models.json
# For ordinary Zhipu BigModel API: PI_PROVIDER=zhipu, PI_MODEL=glm-5.2
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
# Set your key here, or log in using the project Pi directory (see README).
PI_API_KEY=
# Opt-in report inspection inside the same Pi agent (max two checks).
# Keep off until the local A/B results justify the extra calls for your model.
REPORT_REVIEW=0

# Successful runs only; preserve reports, assets, transcripts and logs.
# 0 disables a limit. If both are enabled, either limit triggers cleanup.
MEDIA_KEEP_LAST=20
MEDIA_MAX_AGE_DAYS=0

# Media understanding: resolve backend before selecting its default model.
ASR_BACKEND=mlx
# Optional override; omit to use the selected backend's default:
# mlx: mlx-community/whisper-large-v3-turbo
# paraformer: paraformer-v2, paraformer-v1, fun-asr, fun-asr-2025-08-25,
# fun-asr-2025-11-07, fun-asr-mtl, fun-asr-mtl-2025-08-25
# ASR_MODEL=
OCR_BACKEND=rapidocr
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Admin usage statistics at /admin. Empty disables the admin routes.
# Generate your own secret; keep it private. Restart the web server after changes.
ADMIN_TOKEN=
# Optional Paraformer estimate in CNY per second, using your actual plan's rate.
# Empty means unknown. This is an estimate, not a provider billing statement.
ASR_CNY_PER_SECOND=
