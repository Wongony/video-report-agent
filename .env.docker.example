# Copy to .env.docker; never include credentials in the image or transfer archive.
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
PI_API_KEY=
ASR_BACKEND=paraformer
ASR_MODEL=paraformer-v2
# Also supports paraformer-v1, fun-asr, fun-asr-2025-08-25,
# fun-asr-2025-11-07, fun-asr-mtl, fun-asr-mtl-2025-08-25.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ADMIN_TOKEN=
ASR_CNY_PER_SECOND=
MEDIA_KEEP_LAST=20
MEDIA_MAX_AGE_DAYS=0
WEB_PORT=8765
PUBLIC_ORIGIN=http://localhost:8765
# For Windows deployment set PUBLIC_ORIGIN=https://reports.your-domain.com
CLOUDFLARE_TUNNEL_TOKEN=
